# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file to version control.

# --- Database (Neon PostgreSQL) ---
# Create a database at https://neon.tech and copy its pooler connection string.
# The connection string is only ever used server-side.
# The app also runs WITHOUT this variable, falling back to static placeholder
# content in src/lib/content so the whole site is browsable before the DB is
# set up. To use the database: copy to .env, then run:
#   npm run db:deploy   (applies prisma/migrations/0000_init)
#   npm run db:seed     (loads the placeholder content as rows)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Optional direct (non-pooler) connection used for migrations and one-off
# scripts. Neon pooler connections can time out on long-running DDL.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# --- Authentication ---
# Generate one with: openssl rand -base64 32   (or the Node equivalent)
AUTH_SECRET="replace-with-a-long-random-secret"

# Fallback admin account used until a database is connected. The seed script
# (npm run db:seed) creates the same account in the User table when running
# with a database. CHANGE THESE BEFORE A REAL LAUNCH.
ADMIN_EMAIL="admin@placeoffavour.org"
ADMIN_PASSWORD="Favour@2024"

# --- Public site ---
# Public URL of the deployed site (used for canonical URLs, sitemaps, etc.)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"